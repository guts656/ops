# Copy this file to .env.production on the target server and replace every placeholder.
# Do not commit the real .env.production file.

NODE_ENV=production
PORT=3001

# PostgreSQL connection. Use the address reachable from the API container.
# With api.network_mode=host, a PostgreSQL service on the Docker host can use 127.0.0.1.
DATABASE_URL="postgresql://ops_platform:<db-password>@127.0.0.1:5432/ops_platform?schema=public"

# Web/Nginx port and allowed browser origins.
WEB_PORT=18080
CORS_ORIGINS=http://<server-ip>:18080

# Production secrets must be strong random values, at least 32 characters.
JWT_SECRET=<replace-with-at-least-32-random-characters>
JWT_EXPIRES_IN=2h
OPS_AGENT_TOKEN_PEPPER=<replace-with-at-least-32-random-characters>

# New credential writes use this key. Keep the same value for existing deployments.
CREDENTIAL_ENCRYPTION_KEY=<replace-with-at-least-32-random-characters>

# Optional migration compatibility. Comma-separated old keys/peppers used only for
# decrypting/verifying existing records during migration. Leave empty for new installs.
LEGACY_CREDENTIAL_ENCRYPTION_KEYS=
LEGACY_AGENT_TOKEN_PEPPERS=

# Initial administrator used by npm run db:seed when the admin account does not exist.
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=<replace-with-a-strong-initial-admin-password>
INITIAL_ADMIN_DISPLAY_NAME=平台管理员

# Agent callback fallback/explicit override.
# By default, new Agent installs use the platform server's detected non-internal IPv4
# plus PORT, for example http://<server-ip>:3001. Set this only when agents must use
# a different reachable URL, such as a reverse proxy/public address.
# OPS_AGENT_PUBLIC_URL=http://<server-ip>:3001
OPS_AGENT_METRICS_INTERVAL_SECONDS=60
OPS_AGENT_METRICS_RETENTION_POINTS=288

# Optional webhook tokens. Set only if webhook ingestion is used.
GENERIC_WEBHOOK_TOKEN=<replace-with-at-least-32-random-characters>
PROMETHEUS_WEBHOOK_TOKEN=<replace-with-at-least-32-random-characters>
ZABBIX_WEBHOOK_TOKEN=<replace-with-at-least-32-random-characters>
GRAFANA_WEBHOOK_TOKEN=<replace-with-at-least-32-random-characters>

HEALTH_REPORT_SCHEDULER_ENABLED=true
HEALTH_REPORT_SCHEDULER_INTERVAL_MS=3600000
HEALTH_REPORT_WEEKLY_DAY=1
HEALTH_REPORT_WEEKLY_HOUR=9
HEALTH_REPORT_WEEKLY_MINUTE=0
LOG_MONITOR_EVALUATOR_INTERVAL_MS=60000
LOG_RETENTION_CLEANUP_INTERVAL_MS=3600000
LOG_RETENTION_DAYS=2
CGI_MONITOR_EVALUATOR_INTERVAL_MS=60000
SSL_CERTIFICATE_SCHEDULER_INTERVAL_MS=60000
SELF_HEALING_EVALUATOR_INTERVAL_MS=60000
ALERT_AUTO_SUPPRESS_ENABLED=false

# Set to false for clean installs that only create permissions and the initial admin user.
# Set to true or omit it if you want bundled demo hosts, alerts, logs, and self-healing rules.
SEED_DEMO_DATA=false
