ARG API_BASE=ops-platform-api:latest
FROM ${API_BASE}

WORKDIR /app
COPY package*.json ./
COPY server ./server
COPY prisma ./prisma
COPY prisma.config.ts ./prisma.config.ts
COPY src/generated ./src/generated

RUN DATABASE_URL="postgresql://ops_platform:placeholder@localhost:5432/ops_platform?schema=public" npm run db:generate
